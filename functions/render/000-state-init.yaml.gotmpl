# code: language=yaml
#
# Initialize $state with spec defaults.
#

{{- $xr := getCompositeResource . }}
{{- $spec := $xr.spec | default dict }}
{{- $metadata := $xr.metadata | default dict }}

# ==============================================================================
# Core defaults
# ==============================================================================
{{- $name := $metadata.name | default "flux-gitops" }}
{{- $clusterName := $spec.clusterName | default $name }}
{{- $namespace := $spec.namespace | default "flux-system" }}
{{- $managementPolicies := $spec.managementPolicies | default (list "*") }}

# Labels
{{- $defaultLabels := dict
  "hops.ops.com.ai/managed" "true"
  (printf "hops.ops.com.ai/%s" (lower $xr.kind)) $name
}}
{{- $labels := merge $defaultLabels ($spec.labels | default dict) }}

# Helm provider config (defaults to clusterName)
{{- $helmProviderConfigRef := $spec.helmProviderConfigRef | default dict }}
{{- $helmProviderConfigRef = dict
  "name" ($helmProviderConfigRef.name | default $clusterName)
  "kind" ($helmProviderConfigRef.kind | default "ProviderConfig")
}}

# Kubernetes provider config (defaults to clusterName)
{{- $k8sProviderConfigRef := $spec.kubernetesProviderConfigRef | default dict }}
{{- $k8sProviderConfigRef = dict
  "name" ($k8sProviderConfigRef.name | default $clusterName)
  "kind" ($k8sProviderConfigRef.kind | default "ProviderConfig")
}}

# GitHub provider config (defaults to "default")
{{- $ghProviderConfigRef := $spec.githubProviderConfigRef | default dict }}
{{- $ghProviderConfigRef = dict
  "name" ($ghProviderConfigRef.name | default "default")
  "kind" ($ghProviderConfigRef.kind | default "ProviderConfig")
}}

# ==============================================================================
# NodePool configuration
# ==============================================================================
{{- $nodePoolSpec := $spec.nodePool | default dict }}
{{- $nodePoolEnabled := false }}
{{- if hasKey $nodePoolSpec "enabled" }}
  {{- $nodePoolEnabled = $nodePoolSpec.enabled }}
{{- end }}
{{- $nodePoolName := $nodePoolSpec.name | default "hops-gitops" }}
{{- $nodePoolNodeClassName := $nodePoolSpec.nodeClassName | default "hops-default" }}
{{- $nodePoolLimits := $nodePoolSpec.limits | default (dict "nodes" 10) }}
{{- $nodePoolRequirements := $nodePoolSpec.requirements | default (list
  (dict "key" "karpenter.sh/capacity-type" "operator" "In" "values" (list "spot" "on-demand"))
  (dict "key" "eks.amazonaws.com/instance-category" "operator" "In" "values" (list "c" "m" "r"))
  (dict "key" "eks.amazonaws.com/instance-generation" "operator" "Gt" "values" (list "4"))
  (dict "key" "eks.amazonaws.com/instance-memory" "operator" "Gt" "values" (list "7999"))
  (dict "key" "eks.amazonaws.com/instance-cpu" "operator" "Gt" "values" (list "1"))
  (dict "key" "kubernetes.io/arch" "operator" "In" "values" (list "amd64"))
  (dict "key" "kubernetes.io/os" "operator" "In" "values" (list "linux"))
) }}
{{- $nodePoolDisruption := $nodePoolSpec.disruption | default (dict "consolidationPolicy" "WhenEmptyOrUnderutilized" "consolidateAfter" "60s") }}
{{- $nodePoolTaintKey := "gitops" }}
{{- $nodePoolTaintValue := "true" }}
{{- $nodePoolNodeSelector := dict }}
{{- $nodePoolTolerations := list }}
{{- if $nodePoolEnabled }}
  {{- $nodePoolNodeSelector = dict "workload-type" "gitops" }}
  {{- $nodePoolTolerations = list (dict "key" $nodePoolTaintKey "operator" "Equal" "value" $nodePoolTaintValue "effect" "NoSchedule") }}
{{- end }}

# ==============================================================================
# Flux configuration
# ==============================================================================
{{- $fluxSpec := $spec.flux | default dict }}

# ==============================================================================
# Repository configuration
# ==============================================================================
{{- $repoSpec := $spec.repository | default dict }}
{{- $repoOrg := $repoSpec.org }}
{{- $repoName := $repoSpec.name | default (printf "%s-gitops" $clusterName) }}
{{- $repoUrl := printf "https://github.com/%s/%s.git" $repoOrg $repoName }}

# Template config (optional)
{{- $repoTemplate := $repoSpec.template | default dict }}
{{- $repoAutoInit := true }}
{{- if hasKey $repoSpec "autoInit" }}
  {{- $repoAutoInit = $repoSpec.autoInit }}
{{- end }}
{{- $repoDeleteBranchOnMerge := true }}
{{- if hasKey $repoSpec "deleteBranchOnMerge" }}
  {{- $repoDeleteBranchOnMerge = $repoSpec.deleteBranchOnMerge }}
{{- end }}

# ==============================================================================
# External Secrets configuration
# ==============================================================================
{{- $esoSpec := $spec.externalSecrets | default dict }}
{{- $ghAppSpec := $esoSpec.githubApp | default dict }}
{{- $esoEnabled := false }}
{{- if hasKey $esoSpec "enabled" }}
  {{- $esoEnabled = $esoSpec.enabled }}
{{- end }}

# ==============================================================================
# Source and Kustomization configuration
# ==============================================================================
{{- $sourceSpec := $spec.source | default dict }}
{{- $kustomizationsSpec := $spec.kustomizations | default dict }}
{{- $appsSpec := $kustomizationsSpec.apps | default dict }}
{{- $crossplaneSpec := $kustomizationsSpec.crossplane | default dict }}
{{- $appsEnabled := true }}
{{- if hasKey $appsSpec "enabled" }}
  {{- $appsEnabled = $appsSpec.enabled }}
{{- end }}
{{- $appsPrune := true }}
{{- if hasKey $appsSpec "prune" }}
  {{- $appsPrune = $appsSpec.prune }}
{{- end }}
{{- $appsWait := true }}
{{- if hasKey $appsSpec "wait" }}
  {{- $appsWait = $appsSpec.wait }}
{{- end }}
{{- $crossplaneEnabled := false }}
{{- if hasKey $crossplaneSpec "enabled" }}
  {{- $crossplaneEnabled = $crossplaneSpec.enabled }}
{{- end }}
{{- $crossplanePrune := true }}
{{- if hasKey $crossplaneSpec "prune" }}
  {{- $crossplanePrune = $crossplaneSpec.prune }}
{{- end }}
{{- $crossplaneWait := true }}
{{- if hasKey $crossplaneSpec "wait" }}
  {{- $crossplaneWait = $crossplaneSpec.wait }}
{{- end }}

# ==============================================================================
# Initialize $state
# ==============================================================================
{{- $state := dict
  "name" $name
  "clusterName" $clusterName
  "namespace" $namespace
  "managementPolicies" $managementPolicies
  "labels" $labels
  "helmProviderConfigRef" $helmProviderConfigRef
  "kubernetesProviderConfigRef" $k8sProviderConfigRef
  "githubProviderConfigRef" $ghProviderConfigRef
  "nodePool" (dict
    "enabled" $nodePoolEnabled
    "name" $nodePoolName
    "nodeClassName" $nodePoolNodeClassName
    "limits" $nodePoolLimits
    "requirements" $nodePoolRequirements
    "disruption" $nodePoolDisruption
    "taintKey" $nodePoolTaintKey
    "taintValue" $nodePoolTaintValue
    "nodeSelector" $nodePoolNodeSelector
    "tolerations" $nodePoolTolerations
  )
  "flux" (dict
    "name" ($fluxSpec.name | default "flux")
    "namespace" ($fluxSpec.namespace | default $namespace)
    "values" ($fluxSpec.values | default dict)
    "overrideAllValues" ($fluxSpec.overrideAllValues | default dict)
  )
  "repository" (dict
    "org" $repoOrg
    "name" $repoName
    "description" ($repoSpec.description | default (printf "GitOps repository for %s cluster" $clusterName))
    "visibility" ($repoSpec.visibility | default "private")
    "template" $repoTemplate
    "autoInit" $repoAutoInit
    "topics" ($repoSpec.topics | default list)
    "deleteBranchOnMerge" $repoDeleteBranchOnMerge
    "allowDelete" ($repoSpec.allowDelete | default false)
    "url" $repoUrl
  )
  "externalSecrets" (dict
    "enabled" $esoEnabled
    "secretStoreName" ($esoSpec.secretStoreName | default "default")
    "secretName" ($esoSpec.secretName | default "gitops-github-app")
    "githubApp" (dict
      "secretPath" ($ghAppSpec.secretPath | default "")
      "appIdKey" ($ghAppSpec.appIdKey | default "appId")
      "installationOwnerKey" ($ghAppSpec.installationOwnerKey | default "")
      "installationIdKey" ($ghAppSpec.installationIdKey | default "")
      "privateKeyKey" ($ghAppSpec.privateKeyKey | default "privateKey")
    )
  )
  "source" (dict
    "name" ($sourceSpec.name | default "gitops")
    "branch" ($sourceSpec.branch | default "main")
    "interval" ($sourceSpec.interval | default "5m")
    "timeout" ($sourceSpec.timeout | default "60s")
  )
  "kustomizations" (dict
    "apps" (dict
      "enabled" $appsEnabled
      "name" ($appsSpec.name | default "apps")
      "path" ($appsSpec.path | default "./apps")
      "interval" ($appsSpec.interval | default "10m")
      "prune" $appsPrune
      "wait" $appsWait
      "timeout" ($appsSpec.timeout | default "2m")
    )
    "crossplane" (dict
      "enabled" $crossplaneEnabled
      "name" ($crossplaneSpec.name | default "crossplane")
      "path" ($crossplaneSpec.path | default "./crossplane")
      "interval" ($crossplaneSpec.interval | default "10m")
      "prune" $crossplanePrune
      "wait" $crossplaneWait
      "timeout" ($crossplaneSpec.timeout | default "2m")
    )
  )
  "observed" (dict)
  "status" (dict)
}}
