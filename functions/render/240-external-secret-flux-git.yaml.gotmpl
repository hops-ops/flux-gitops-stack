# code: language=yaml
#
# ExternalSecret: Flux GitRepository credentials via GitHub App.
#
# Creates an ExternalSecret that pulls GitHub App credentials from AWS Secrets
# Manager and writes a Flux-compatible Secret referenced by GitRepository.
# Gated on: externalSecrets.enabled AND Flux ready (namespace must exist).
#
# Prerequisite: SecretStack must be installed (provides ESO + ClusterSecretStore).
#

{{- $eso := $state.externalSecrets }}
{{- $obs := $state.observed }}
{{- $githubApp := $eso.githubApp }}
{{- $useInstallationID := ne $githubApp.installationIdKey "" }}
{{- $useRemoteInstallationOwner := and (not $useInstallationID) (ne $githubApp.installationOwnerKey "") }}

{{- if and $eso.enabled $obs.flux.ready }}
---
apiVersion: kubernetes.m.crossplane.io/v1alpha1
kind: Object
metadata:
  name: gitops-auth-secret
  annotations:
    {{ setResourceNameAnnotation "gitops-auth-secret" }}
  labels: {{ $state.labels | toJson }}
spec:
  managementPolicies: {{ $state.managementPolicies | toJson }}
  readiness:
    policy: DeriveFromObject
  forProvider:
    manifest:
      apiVersion: external-secrets.io/v1
      kind: ExternalSecret
      metadata:
        name: {{ $eso.secretName }}
        namespace: {{ $state.flux.namespace }}
      spec:
        refreshInterval: 1h
        secretStoreRef:
          name: {{ $eso.secretStoreName }}
          kind: ClusterSecretStore
        target:
          name: {{ $eso.secretName }}
          creationPolicy: Owner
          template:
            type: Opaque
            data:
              githubAppID: {{ `"{{ .githubAppID }}"` }}
              {{- if $useInstallationID }}
              githubAppInstallationID: {{ `"{{ .githubAppInstallationID }}"` }}
              {{- else if $useRemoteInstallationOwner }}
              githubAppInstallationOwner: {{ `"{{ .githubAppInstallationOwner }}"` }}
              {{- else }}
              githubAppInstallationOwner: {{ $state.repository.org }}
              {{- end }}
              githubAppPrivateKey: {{ `"{{ .githubAppPrivateKey }}"` }}
        data:
        - secretKey: githubAppID
          remoteRef:
            key: {{ $githubApp.secretPath }}
            property: {{ $githubApp.appIdKey }}
        {{- if $useInstallationID }}
        - secretKey: githubAppInstallationID
          remoteRef:
            key: {{ $githubApp.secretPath }}
            property: {{ $githubApp.installationIdKey }}
        {{- else if $useRemoteInstallationOwner }}
        - secretKey: githubAppInstallationOwner
          remoteRef:
            key: {{ $githubApp.secretPath }}
            property: {{ $githubApp.installationOwnerKey }}
        {{- end }}
        - secretKey: githubAppPrivateKey
          remoteRef:
            key: {{ $githubApp.secretPath }}
            property: {{ $githubApp.privateKeyKey }}
  providerConfigRef:
    name: {{ $state.kubernetesProviderConfigRef.name }}
    kind: {{ $state.kubernetesProviderConfigRef.kind }}

{{- if $obs.authSecret.ready }}
---
apiVersion: protection.crossplane.io/v1beta1
kind: Usage
metadata:
  name: delete-auth-secret-before-flux
  annotations:
    {{ setResourceNameAnnotation "usage-auth-secret-before-flux" }}
  labels: {{ $state.labels | toJson }}
spec:
  replayDeletion: true
  of:
    apiVersion: helm.m.crossplane.io/v1beta1
    kind: Release
    resourceRef:
      name: {{ $state.flux.name }}
  by:
    apiVersion: kubernetes.m.crossplane.io/v1alpha1
    kind: Object
    resourceRef:
      name: gitops-auth-secret
{{- end }}

{{- end }}
